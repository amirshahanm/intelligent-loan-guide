# Public project URL. Safe to expose to the browser when needed.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-only Supabase credential. NEVER prefix this with VITE_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=replace-at-deploy-time

# Production enables fail-closed backend/provider checks.
# Leave unset for local/demo preview unless you intentionally want production behavior.
TASHILRADAR_DEPLOYMENT_MODE=production
